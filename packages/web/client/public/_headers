# Cloudflare Pages reads this file at deploy time and applies it to static asset responses. It is
# parsed, not served. Max 100 rules; `cache-headers.test.ts` counts them.

# VITE'S OWN OUTPUT IS CONTENT-HASHED (`index-B_kCz-LY.js`), so its name changes whenever its bytes
# do.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# THE 404 PAGE IS NEVER REUSED. It exists so that a MISSING file 404s like a missing file rather
# than being answered with the app shell at 200 -- the defect of 2026-09-04, where a browser cached
# HTML under a JavaScript URL behind the `immutable` rule above. A 404 that is itself cached would
# reintroduce the same shape one status code over: a path that starts working would keep answering
# "gone" from a stale entry. `max-age=0, must-revalidate` rather than `no-store`, matching `sw.js`
# and `index.html` above -- and `cache-headers.test.ts` requires an explicit max-age on every
# shipped file, which `no-store` alone does not give it.
/404.html
  Cache-Control: public, max-age=0, must-revalidate

# THE ONE FILE THAT IS NOT CONTENT-ADDRESSED, and therefore the only one that has to stay fresh:
# it names the version directory everything else hangs off. A minute of caching keeps a burst of
# analyses off the origin without letting a corpus rebuild take an hour to reach anyone.
/static/manifest.json
  Cache-Control: public, max-age=60, must-revalidate

# AND NOW THE CARDS REALLY ARE IMMUTABLE. A shard's filename hashes the card NAMES inside it, not
# its bytes, so `1be5.json` used to survive a rebuild that changed every card in it -- which is why
# this rule read `max-age=3600` and could not read anything stronger. Under `v-<content hash>/` the
# URL changes exactly when the bytes do, so a year is correct rather than optimistic, and a service
# worker can go cache-first here without freezing a reader on last month's oracle text.
/static/v-*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# THE WORKER MUST NEVER BE CACHED HARD. It is the thing that decides what everything else is allowed
# to serve, so a stale copy is the one failure that cannot fix itself on the next load. Browsers cap
# it at 24h on their own; this says the truth out loud.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# EVERYTHING BELOW USED TO FREE-RIDE ON A ZONE SETTING, which is a bad place for a cache policy to
# live: it is not in this repo, it is not reviewed, and it silently rewrote the two rules above it.
#
# Cloudflare's Browser Cache TTL overrides the origin whenever the ORIGIN'S VALUE IS LOWER (documented
# behaviour, and measured on this site 2026-09-03). Pages sends `max-age=0, must-revalidate` for any
# file no rule names, so the zone's 4-hour default was raising all of these to 14400 -- and raising
# `/sw.js` from 0 to 14400 with it, pinning readers to a four-hour-old service worker, which the note
# above says is the one failure that cannot fix itself.
#
# With the zone set to "Respect Existing Headers" these files would revalidate on EVERY page load, so
# they get explicit rules instead. Same caching as before, stated here where it can be read.

# Content-addressed by neither name nor bytes, but they change roughly never and a stale one is
# cosmetic.
/favicon.svg
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/icons/*
  Cache-Control: public, max-age=604800

# The social preview. A crawler re-reads it on its own schedule; a week is generous and harmless.
/og-image.png
  Cache-Control: public, max-age=604800

# Machine-readable metadata. An hour keeps a crawler from re-reading it every hit without making a
# correction wait a day.
/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

# THE INDEX'S CHILDREN (AI5). They are generated into `dist` rather than shipped from `public/`, so
# `cache-headers.test.ts` never sees them and cannot ask for this rule -- which is exactly why it is
# written down: without it they free-ride on the zone setting this whole section exists to stop.
/sitemap-*
  Cache-Control: public, max-age=3600

# THE INDEXNOW KEY (AI4). The protocol's only check is that this file is fetchable and contains its
# own filename, so it is public by design and must never be treated as a secret. Named explicitly
# rather than matched by a `*.txt` wildcard, which would swallow `llms.txt` above: rotating the key
# means editing this line, and `cache-headers.test.ts` fails the build if anyone forgets.
/1c5d74be24ce43a474e3c6a0a0f3d346.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600

/manifest.webmanifest
  Cache-Control: public, max-age=3600

# RFC 9116 disclosure contact. An hour, like the other machine-readable files: long enough that a
# scanner re-reading it costs nothing, short enough that a corrected contact address is live the same
# afternoon.
/.well-known/security.txt
  Cache-Control: public, max-age=3600

# THE SECURITY HEADERS, ON EVERYTHING (security review 2026-09-25). Last, so every rule above keeps
# its own Cache-Control: Pages merges the headers of every matching rule. The values are
# `client/src/lib/csp.ts`, which is also what a Pages Function sends -- `_headers` never reaches a
# Function -- and `csp.test.ts` fails if the two differ. The script hashes are the two inline
# scripts in `index.html` and `how-it-works/index.html`; edit one and the test says so.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-MMSegDRg2Xk7IZm9a0Jb9yM9fj1Dhfd/vUGnbdAp0cI=' 'sha256-ie8i0uGFgJjmI0/MAHs2apORlp5Cdou/KMObaQWmXRs=' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' https://cards.scryfall.io blob: data:; font-src 'self'; connect-src 'self' https://cards.scryfall.io https://cloudflareinsights.com; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
