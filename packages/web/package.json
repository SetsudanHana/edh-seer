{
  "name": "@edh-seer/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build:server": "nest build",
    "start:server": "node --import tsx dist/main.js",
    "dev:server": "NODE_OPTIONS=\"--import tsx\" nest start --watch",
    "dev:client": "vite --config client/vite.config.ts",
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "build:client": "vite --config client/vite.config.ts build",
    "build:static-site": "VITE_STATIC_DATA=1 vite --config client/vite.config.ts build && node scripts/assemble-deploy.mjs",
    "deploy": "npm run build:static-site && npx -y wrangler@4 pages deploy client/dist --project-name edhseer",
    "test": "npm run test:server && npm run test:client",
    "test:server": "vitest run --config server/vitest.config.ts",
    "test:client": "vitest run --config client/vitest.config.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.0.0",
    "@edh-seer/data": "*",
    "@edh-seer/engine": "*",
    "@edh-seer/matcher": "*",
    "@edh-seer/tagger": "*",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-fastify": "^11.2.3",
    "d3-force": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "framer-motion": "^12.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.2.3",
    "@swc/core": "^1.16.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.6",
    "@types/d3-force": "^3.0.10",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.4.0",
    "unplugin-swc": "^1.5.11",
    "vite": "^8.2.2",
    "vitest": "^4.0.0"
  }
}
