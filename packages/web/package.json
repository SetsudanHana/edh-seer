{
  "name": "@edh-seer/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build:server": "tsc -p server/tsconfig.json",
    "start:server": "node --import tsx dist/main.js",
    "dev:server": "concurrently -n tsc,api -c gray,blue \"tsc -p server/tsconfig.json --watch --preserveWatchOutput\" \"node --watch --import tsx dist/main.js\"",
    "dev:client": "vite --config client/vite.config.ts",
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "build:client": "vite --config client/vite.config.ts build",
    "build:static-site": "VITE_STATIC_DATA=1 vite --config client/vite.config.ts build && node scripts/assemble-deploy.mjs",
    "deploy": "npm run build:static-site && npx -y wrangler@4 pages deploy client/dist --project-name edhseer",
    "deploy:indexnow": "node scripts/indexnow.mjs",
    "test": "npm run test:server && npm run test:client",
    "test:server": "vitest run --config server/vitest.config.ts",
    "test:client": "vitest run --config client/vitest.config.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit && tsc -p functions/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@edh-seer/data": "*",
    "@edh-seer/engine": "*",
    "@edh-seer/matcher": "*",
    "@edh-seer/tagger": "*",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-fastify": "^12.0.3",
    "d3-force": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "fastify": "^5.12.3",
    "mana-font": "^1.18.0",
    "mongodb": "^7.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.3",
    "@swc/core": "^1.16.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "unplugin-swc": "^1.6.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
