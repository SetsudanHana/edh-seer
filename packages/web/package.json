{
  "name": "@edh-seer/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:client": "vite --config client/vite.config.ts",
    "dev": "vite --config client/vite.config.ts",
    "build:client": "vite --config client/vite.config.ts build",
    "build:static-site": "vite --config client/vite.config.ts build && node scripts/assemble-deploy.mjs",
    "deploy": "npm run build:static-site && wrangler pages deploy client/dist --project-name edhseer",
    "deploy:indexnow": "node scripts/indexnow.mjs",
    "test": "vitest run --config client/vitest.config.ts",
    "test:client": "vitest run --config client/vitest.config.ts",
    "typecheck": "tsc -p client/tsconfig.json --noEmit && tsc -p functions/tsconfig.json --noEmit",
    "screenshots": "tsx scripts/docs-screenshots.mts",
    "demo-gif": "tsx scripts/demo-gif.mts"
  },
  "dependencies": {
    "@edh-seer/data": "*",
    "@edh-seer/engine": "*",
    "@edh-seer/matcher": "*",
    "@edh-seer/tagger": "*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "d3-force": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "mana-font": "^1.18.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "gifenc": "^1.0.3",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
