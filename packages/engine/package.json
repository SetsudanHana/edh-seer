{
  "name": "@edh-seer/engine",
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "//exports": "The barrel is NODE-ONLY: index.ts pulls analyze.ts, which readFileSync's its tag weights at module load. Pure-computation modules a browser may evaluate get their own subpath here.",
  "exports": {
    ".": "./src/index.ts",
    "./hypergeometric": "./src/hypergeometric.ts",
    "./percent": "./src/percent.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:weights": "tsx scripts/gen-tag-weights.ts"
  },
  "devDependencies": {
    "@edh-seer/data": "*",
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  }
}
