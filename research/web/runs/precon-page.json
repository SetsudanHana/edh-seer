{
  "surface": "precon-page",
  "baseUrl": "http://localhost:5173",
  "keyScreens": [
    {
      "id": "precon",
      "path": "/precons/party-time-commander-legends-battle-for-baldurs-gate"
    }
  ],
  "measure": [
    "h1",
    "h2",
    "p.eyebrow",
    ".chip",
    ".btn-primary",
    ".btn-secondary"
  ],
  "steps": [
    {
      "id": "precon",
      "path": "/precons/party-time-commander-legends-battle-for-baldurs-gate",
      "goal": "I own this precon and keep losing to my friends' upgraded decks: find what to change first"
    },
    {
      "id": "upgrades",
      "goal": "see what each change is and what it replaces",
      "acts": [
        {
          "any": [
            {
              "click": "a[href='#upgrades']"
            },
            {
              "click": "a[href='#swaps']"
            }
          ]
        },
        {
          "click": "button[aria-expanded]:has-text('more')"
        }
      ]
    },
    {
      "id": "bracket-3",
      "goal": "my friends play at bracket 3: see what changes if I aim for that",
      "acts": [
        {
          "click": "button[aria-pressed]:has-text('Bracket 3')"
        }
      ]
    }
  ]
}
